# =====================================================================
# InternshipPilot AI · environment template
# Copy to .env (local) and never commit real values.
# Browser-visible variables are prefixed NEXT_PUBLIC_ and must contain
# ONLY the public anon key. The service role key is server/CI only.
# =====================================================================

# ---- Web app (Next.js on Vercel, and web/.env.local locally) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Pipeline (GitHub Actions secrets, or pipeline/.env locally) ------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Bypasses RLS. Never expose to the browser, Vercel client env, or logs.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Gemini (optional). Leave GEMINI_API_KEY empty to run deterministic-only.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Self-imposed daily cap, set BELOW your real free-tier quota. Counted in UTC.
GEMINI_DAILY_CALL_CAP=40
# Max Gemini calls in a single pipeline run.
GEMINI_RUN_CALL_CAP=25

# Polite scraping identity. Put a real page or repo you control here.
SCRAPER_CONTACT_URL=https://github.com/YOUR-GITHUB-USER/internshippilot-ai
SCRAPER_CONTACT_EMAIL=you@example.com
REQUEST_MIN_INTERVAL_SECONDS=2
HTTP_TIMEOUT_SECONDS=20

# Retention and health
STALE_JOB_DAYS=21
SOURCE_FAILURE_LIMIT=5
