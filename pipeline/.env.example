# pipeline/.env (local) or GitHub Actions secrets. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Bypasses Row Level Security. Server and CI only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALL_CAP=40
GEMINI_RUN_CALL_CAP=25

SCRAPER_CONTACT_URL=https://github.com/YOUR-GITHUB-USER/internshippilot-ai
SCRAPER_CONTACT_EMAIL=you@example.com
REQUEST_MIN_INTERVAL_SECONDS=2
HTTP_TIMEOUT_SECONDS=20
STALE_JOB_DAYS=21
SOURCE_FAILURE_LIMIT=5

# Optional phone notification when matches are queued. Use a long random topic (16+ characters).
NTFY_TOPIC=
