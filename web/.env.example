# web/.env.local (local) or Vercel Project Settings > Environment Variables.
# ONLY public values belong here. Never add the server-only (service_role) key to the web app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Local: http://localhost:3000. Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
